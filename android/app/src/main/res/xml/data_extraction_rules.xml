<?xml version="1.0" encoding="utf-8"?>
<!-- HabitFlow no guarda copia de seguridad del celular: al borrar y reinstalar la app empieza
     de cero (introducción e inicio de sesión). El progreso está en Firebase, no se pierde. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
